// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  phone        String?  @db.VarChar(20)
  address      String?  @db.Text
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  pincode      String?  @db.VarChar(20)
  isAdmin      Boolean  @default(false) @map("is_admin")
  customerType String?  @default("sales person") @map("customer_type") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  categories           Category[]
  items                Item[]
  transactions         Transaction[]   @relation("CustomerTransactions")
  transactionCustomers Transaction[]   @relation("TransactionCustomers")
  editedTransactions   Transaction[]   @relation("TransactionEditor")
  returnRecords        ReturnRecord[]
  approvedReturns      ReturnRecord[]        @relation("ReturnApprover")
  processedReturns     ReturnRecord[]        @relation("ReturnProcessor")
  company              Company?
  settings             Settings?
  activityLogs         ActivityLog[]
  cashFlowEntries      CashFlowEntry[]
  carts                Cart[]
  tables               Table[]
  tableOrders          TableOrder[]
  translations         Translation[]
  eWayBills            EWayBill[]
  uomMasters           UomMaster[]
  uomConversions       UomConversion[]

  @@index([email])
  @@index([phone])
  @@index([customerType])
  @@map("customers")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  name        String   @db.VarChar(255)
  subcategory String?  @db.VarChar(255)
  brand       String?  @db.VarChar(255)
  icon        String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    Item[]

  @@index([customerId])
  @@map("categories")
}

model Item {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  name        String   @db.VarChar(255)
  displayName String?  @map("display_name") @db.VarChar(255)
  code        String   @db.VarChar(100)
  barcode     String?  @db.VarChar(255)
  mappingCode String?  @map("mapping_code") @db.VarChar(100)
  categoryId  String?  @map("category_id") @db.Uuid
  subcategory String?  @db.VarChar(255)
  cost        Decimal  @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(10, 2)
  mrp         Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  purchaseQty Int      @default(0) @map("purchase_qty")
  imageUrl    String?  @map("image_url") @db.Text
  hsnCode     String?  @map("hsn_code") @db.VarChar(8)
  gstRate     Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cessRate    Decimal  @default(0) @map("cess_rate") @db.Decimal(5, 2)
  // UOM & Extended Item Details
  uomId            String?   @map("uom_id") @db.Uuid
  weightPerUnit    Decimal?  @map("weight_per_unit") @db.Decimal(10, 3)
  volumePerUnit    Decimal?  @map("volume_per_unit") @db.Decimal(10, 3)
  lengthPerUnit    Decimal?  @map("length_per_unit") @db.Decimal(10, 3)
  widthPerUnit     Decimal?  @map("width_per_unit") @db.Decimal(10, 3)
  heightPerUnit    Decimal?  @map("height_per_unit") @db.Decimal(10, 3)
  manufacturer     String?   @db.VarChar(255)
  brand            String?   @db.VarChar(255)
  modelNumber      String?   @map("model_number") @db.VarChar(100)
  batchNumber      String?   @map("batch_number") @db.VarChar(100)
  expiryDate       DateTime? @map("expiry_date") @db.Date
  shelfLifeDays    Int?      @map("shelf_life_days")
  minStockLevel    Decimal?  @map("min_stock_level") @db.Decimal(10, 2)
  maxStockLevel    Decimal?  @map("max_stock_level") @db.Decimal(10, 2)
  reorderLevel     Decimal?  @map("reorder_level") @db.Decimal(10, 2)
  packageType      String?   @map("package_type") @db.VarChar(50)
  packageQuantity  Int?      @default(1) @map("package_quantity")
  isPerishable     Boolean?  @default(false) @map("is_perishable")
  storageConditions String?  @map("storage_conditions") @db.VarChar(255)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uom            UomMaster?      @relation(fields: [uomId], references: [id])
  quickSaleItems QuickSaleItem[]

  @@index([customerId])
  @@index([categoryId])
  @@index([barcode])
  @@index([code])
  @@index([mappingCode])
  @@index([hsnCode])
  @@map("items")
}

model Transaction {
  id                    String   @id @default(uuid()) @db.Uuid
  customerId            String   @map("customer_id") @db.Uuid
  transactionCustomerId String?  @map("transaction_customer_id") @db.Uuid
  salesCustomerId       String?  @map("sales_customer_id") @db.Uuid
  totalAmount           Decimal  @map("total_amount") @db.Decimal(10, 2)
  paymentMethod         String   @map("payment_method") @db.VarChar(20)
  receivedAmount        Decimal? @map("received_amount") @db.Decimal(10, 2)
  changeAmount          Decimal? @map("change_amount") @db.Decimal(10, 2)
  itemsJson             String   @map("items_json") @db.Text
  transactionType       String   @default("sale") @map("transaction_type") @db.VarChar(20) // 'sale', 'return', 'exchange'
  originalTransactionId String?  @map("original_transaction_id") @db.Uuid
  editedAt              DateTime? @map("edited_at") @db.Timestamptz(6)
  editedBy              String?  @map("edited_by") @db.Uuid
  gstAmount             Decimal  @default(0) @map("gst_amount") @db.Decimal(10, 2)
  cessAmount            Decimal  @default(0) @map("cess_amount") @db.Decimal(10, 2)
  placeOfSupply         String?  @map("place_of_supply") @db.VarChar(50)
  reverseCharge         Boolean  @default(false) @map("reverse_charge")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  customer            Customer       @relation("CustomerTransactions", fields: [customerId], references: [id], onDelete: Cascade)
  transactionCustomer Customer?      @relation("TransactionCustomers", fields: [transactionCustomerId], references: [id], onDelete: SetNull)
  salesCustomer       SalesCustomer? @relation(fields: [salesCustomerId], references: [id], onDelete: SetNull)
  tableOrder          TableOrder?
  quickSaleItems       QuickSaleItem[]
  originalTransaction Transaction? @relation("TransactionReturns", fields: [originalTransactionId], references: [id])
  returnTransactions   Transaction[] @relation("TransactionReturns")
  returns              ReturnRecord[]
  editedByUser         Customer?      @relation("TransactionEditor", fields: [editedBy], references: [id])
  eWayBill            EWayBill?

  @@index([customerId])
  @@index([createdAt])
  @@index([salesCustomerId])
  @@index([transactionType])
  @@index([originalTransactionId])
  @@index([placeOfSupply])
  @@map("transactions")
}

model Company {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @unique @map("customer_id") @db.Uuid
  name            String   @db.VarChar(255)
  address         String?  @db.Text
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  pincode         String?  @db.VarChar(20)
  phone           String?  @db.VarChar(20)
  email           String?  @db.VarChar(255)
  gstin           String?  @db.VarChar(50)
  website         String?  @db.VarChar(255)
  logo            String?  @db.Text
  businessType    String?  @map("business_type") @db.VarChar(50)
  defaultLanguage String?  @default("en") @map("default_language") @db.VarChar(10)
  receiptLanguage String?  @default("en") @map("receipt_language") @db.VarChar(10)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("companies")
}

model Settings {
  id                  String    @id @default(uuid()) @db.Uuid
  customerId          String    @unique @map("customer_id") @db.Uuid
  activityLogEnabled  Boolean   @default(true) @map("activity_log_enabled")
  itemLogActions      String    @default("update_delete") @map("item_log_actions") @db.VarChar(20)
  receiptHeaderOption String    @default("both") @map("receipt_header_option") @db.VarChar(20)
  receiptAutoPrint    Boolean   @default(true) @map("receipt_auto_print")
  languageSettings    Json?     @default("{}") @map("language_settings") @db.JsonB
  supabaseUrl         String?   @map("supabase_url") @db.Text // Encrypted connection string
  lastSyncAt          DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastSyncStatus      String?   @map("last_sync_status") @db.VarChar(50) // 'success', 'failed', 'in_progress'
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("settings")
}

model Translation {
  id        String   @id @default(uuid()) @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  key       String   @db.VarChar(255)
  language  String   @db.VarChar(10)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key, language])
  @@index([customerId])
  @@index([key])
  @@index([language])
  @@map("translations")
}

model EWayBill {
  id               String    @id @default(uuid()) @db.Uuid
  transactionId    String    @unique @map("transaction_id") @db.Uuid
  eWayBillNumber   String?   @unique @map("e_way_bill_number") @db.VarChar(12)
  generatedDate    DateTime? @map("generated_date") @db.Date
  validUntil       DateTime? @map("valid_until") @db.Date
  status           String    @default("active") @db.VarChar(20)
  customerId       String    @map("customer_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([eWayBillNumber])
  @@index([status])
  @@index([validUntil])
  @@map("e_way_bills")
}

model ItemCodePrefix {
  id          String   @id @default(uuid()) @db.Uuid
  prefix      String   @unique @db.VarChar(255)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([prefix])
  @@map("item_code_prefixes")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(20)
  changedBy  String   @map("changed_by") @db.Uuid
  changes    Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  changedByCustomer Customer @relation(fields: [changedBy], references: [id], onDelete: Cascade)

  @@index([entityType])
  @@index([entityId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("activity_logs")
}

model SalesCustomer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  mobile    String   @db.VarChar(20)
  email     String?  @db.VarChar(255)
  place     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  transactions Transaction[]
  carts        Cart[]

  @@index([mobile])
  @@map("sales_customers")
}

model QuickSaleItem {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(255)
  quantity         Int
  price            Decimal   @db.Decimal(10, 2)
  cost             Decimal?  @db.Decimal(10, 2)
  totalAmount      Decimal   @map("total_amount") @db.Decimal(10, 2)
  soldAt           DateTime  @default(now()) @map("sold_at") @db.Timestamptz(6)
  addedToInventory Boolean   @default(false) @map("added_to_inventory")
  inventoryItemId  String?   @map("inventory_item_id") @db.Uuid
  transactionId    String?   @map("transaction_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  inventoryItem Item?        @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([addedToInventory])
  @@index([inventoryItemId])
  @@index([soldAt])
  @@index([transactionId])
  @@map("quick_sale_items")
}

model CashFlowEntry {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  type        String   @db.VarChar(20) // 'income' or 'expense'
  category    String   @db.VarChar(100) // Predefined category names
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.Text
  entryDate   DateTime @map("entry_date") @db.Timestamptz(6) // Date of the transaction
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([entryDate])
  @@index([type])
  @@index([category])
  @@map("cash_flow_entries")
}

model Permission {
  id            String   @id @default(uuid()) @db.Uuid
  customerType  String   @map("customer_type") @db.VarChar(50) // 'sales person', 'manager', 'Admin'
  page          String   @db.VarChar(100) // Page identifier (e.g., 'dashboard', 'sales', 'reports')
  canView       Boolean  @default(false) @map("can_view")
  canEdit       Boolean  @default(false) @map("can_edit")
  canDelete     Boolean  @default(false) @map("can_delete")
  canViewProfit Boolean  @default(false) @map("can_view_profit")
  isHidden      Boolean  @default(false) @map("is_hidden") // Hide page from admin navigation
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([customerType, page])
  @@index([customerType])
  @@index([page])
  @@map("permissions")
}

model Cart {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  itemsJson     String   @map("items_json") @db.Text
  taxRate       Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discount      Decimal  @default(0) @map("discount") @db.Decimal(10, 2)
  paymentMethod String?  @map("payment_method") @db.VarChar(20)
  salesCustomerId String? @map("sales_customer_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesCustomer SalesCustomer? @relation(fields: [salesCustomerId], references: [id], onDelete: SetNull)

  @@unique([customerId])
  @@index([customerId])
  @@map("carts")
}

model Table {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  tableNumber String   @map("table_number") @db.VarChar(50)
  capacity    Int      @default(4)
  status      String   @default("available") @map("status") @db.VarChar(20) // 'available', 'occupied', 'reserved'
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   TableOrder[]

  @@unique([customerId, tableNumber])
  @@index([customerId])
  @@index([status])
  @@map("tables")
}

model TableOrder {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  tableId       String   @map("table_id") @db.Uuid
  status        String   @default("pending") @map("status") @db.VarChar(20) // 'pending', 'completed', 'cancelled'
  itemsJson     String   @map("items_json") @db.Text
  taxRate       Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discount      Decimal  @default(0) @map("discount") @db.Decimal(10, 2)
  totalAmount   Decimal? @map("total_amount") @db.Decimal(10, 2)
  paymentMethod String?  @map("payment_method") @db.VarChar(20)
  transactionId String?  @unique @map("transaction_id") @db.Uuid
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  table       Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@map("table_orders")
}

model ReturnRecord {
  id                      String   @id @default(uuid()) @db.Uuid
  originalTransactionId   String   @map("original_transaction_id") @db.Uuid
  customerId              String   @map("customer_id") @db.Uuid
  returnType              String   @map("return_type") @db.VarChar(20) // 'full', 'partial', 'exchange', 'refund'
  reason                  String?  @db.Text
  status                  String   @default("pending") @db.VarChar(20) // 'pending', 'approved', 'processed', 'rejected'
  refundAmount            Decimal? @map("refund_amount") @db.Decimal(10, 2)
  restockedItems          Json?    @map("restocked_items") @db.JsonB
  exchangeItems           Json?    @map("exchange_items") @db.JsonB
  notes                   String?  @db.Text
  approvedBy              String?  @map("approved_by") @db.Uuid
  processedBy             String?  @map("processed_by") @db.Uuid
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz(6)
  processedAt             DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer            Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  originalTransaction Transaction  @relation(fields: [originalTransactionId], references: [id])
  approvedByUser      Customer?    @relation("ReturnApprover", fields: [approvedBy], references: [id])
  processedByUser     Customer?    @relation("ReturnProcessor", fields: [processedBy], references: [id])

  @@index([customerId])
  @@index([originalTransactionId])
  @@index([status])
  @@index([returnType])
  @@index([createdAt])
  @@map("returns")
}

model UomMaster {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  name             String   @db.VarChar(50)
  code             String   @db.VarChar(10)
  category         String   @db.VarChar(20)
  baseUomId        String?  @map("base_uom_id") @db.Uuid
  conversionFactor Decimal? @default(1.0) @map("conversion_factor") @db.Decimal(10, 6)
  isBaseUom        Boolean  @default(false) @map("is_base_uom")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items            Item[]
  
  baseUom          UomMaster?    @relation("BaseUomRelation", fields: [baseUomId], references: [id])
  derivedUoms      UomMaster[]   @relation("BaseUomRelation")

  conversionsFrom  UomConversion[] @relation("FromUom")
  conversionsTo    UomConversion[] @relation("ToUom")

  @@map("uom_master")
}

model UomConversion {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  fromUomId        String   @map("from_uom_id") @db.Uuid
  toUomId          String   @map("to_uom_id") @db.Uuid
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(10, 6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromUom          UomMaster @relation("FromUom", fields: [fromUomId], references: [id], onDelete: Cascade)
  toUom            UomMaster @relation("ToUom", fields: [toUomId], references: [id], onDelete: Cascade)

  @@unique([customerId, fromUomId, toUomId])
  @@map("uom_conversions")
}
