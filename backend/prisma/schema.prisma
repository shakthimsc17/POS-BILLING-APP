generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                   String          @id @default(uuid()) @db.Uuid
  name                 String          @db.VarChar(255)
  email                String          @unique @db.VarChar(255)
  passwordHash         String          @map("password_hash")
  phone                String?         @db.VarChar(20)
  address              String?
  city                 String?         @db.VarChar(100)
  state                String?         @db.VarChar(100)
  pincode              String?         @db.VarChar(20)
  isAdmin              Boolean         @default(false) @map("is_admin")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customerType         String?         @default("sales person") @map("customer_type") @db.VarChar(50)
  activityLogs         ActivityLog[]
  brands               Brand[]
  supplierBrands       SupplierBrand[]
  suppliers            Supplier[]
  carts                Cart?
  cashFlowEntries      CashFlowEntry[]
  categories           Category[]
  company              Company?
  items                Item[]
  approvedReturns      ReturnRecord[]  @relation("ReturnApprover")
  returnRecords        ReturnRecord[]
  processedReturns     ReturnRecord[]  @relation("ReturnProcessor")
  settings             Settings?
  tableOrders          TableOrder[]
  tables               Table[]
  transactions         Transaction[]   @relation("CustomerTransactions")
  editedTransactions   Transaction[]   @relation("TransactionEditor")
  transactionCustomers Transaction[]   @relation("TransactionCustomers")
  uomConversions       UomConversion[]
  uomMasters           UomMaster[]

  @@index([email])
  @@index([phone])
  @@index([customerType])
  @@map("customers")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  name        String   @db.VarChar(255)
  subcategory String?  @db.VarChar(255)
  brand       String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  icon        String?  @db.VarChar(255)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       Item[]

  @@index([customerId])
  @@map("categories")
}

model Item {
  id             String          @id @default(uuid()) @db.Uuid
  customerId     String          @map("customer_id") @db.Uuid
  name           String          @db.VarChar(255)
  code           String          @db.VarChar(100)
  barcode        String?         @db.VarChar(255)
  categoryId     String?         @map("category_id") @db.Uuid
  subcategory    String?         @db.VarChar(255)
  cost           Decimal         @db.Decimal(10, 2)
  price          Decimal         @db.Decimal(10, 2)
  mrp            Decimal?        @db.Decimal(10, 2)
  stock          Int             @default(0)
  imageUrl       String?         @map("image_url")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  displayName       String?         @map("display_name") @db.VarChar(255)
  displayNameTamil  String?         @map("display_name_tamil") @db.VarChar(255)
  batchNumber       String?         @map("batch_number") @db.VarChar(100)
  purchaseQty       Int             @default(0) @map("purchase_qty")
  mappingCode       String?         @map("mapping_code") @db.VarChar(100)
  hsnCode           String?         @map("hsn_code") @db.VarChar(8)
  gstRate           Decimal         @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cessRate          Decimal         @default(0) @map("cess_rate") @db.Decimal(5, 2)
  uomId             String?         @map("uom_id") @db.Uuid
  weightPerUnit     Decimal?        @map("weight_per_unit") @db.Decimal(10, 3)
  volumePerUnit     Decimal?        @map("volume_per_unit") @db.Decimal(10, 3)
  lengthPerUnit     Decimal?        @map("length_per_unit") @db.Decimal(10, 3)
  widthPerUnit      Decimal?        @map("width_per_unit") @db.Decimal(10, 3)
  heightPerUnit     Decimal?        @map("height_per_unit") @db.Decimal(10, 3)
  manufacturer      String?         @db.VarChar(255)
  brandId           String?         @map("brand_id") @db.Uuid
  supplierId        String?         @map("supplier_id") @db.Uuid
  modelNumber       String?         @map("model_number") @db.VarChar(100)
  expiryDate        DateTime?       @map("expiry_date") @db.Date
  shelfLifeDays     Int?            @map("shelf_life_days")
  minStockLevel     Decimal?        @map("min_stock_level") @db.Decimal(10, 2)
  maxStockLevel     Decimal?        @map("max_stock_level") @db.Decimal(10, 2)
  reorderLevel      Decimal?        @map("reorder_level") @db.Decimal(10, 2)
  packageType       String?         @map("package_type") @db.VarChar(50)
  packageQuantity   Int?            @default(1) @map("package_quantity")
  isPerishable      Boolean?        @default(false) @map("is_perishable")
  storageConditions String?         @map("storage_conditions") @db.VarChar(255)
  category          Category?       @relation(fields: [categoryId], references: [id])
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uom               UomMaster?     @relation(fields: [uomId], references: [id])
  brand             Brand?          @relation(fields: [brandId], references: [id])
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  quickSaleItems    QuickSaleItem[]

  @@index([customerId])
  @@index([categoryId])
  @@index([barcode])
  @@index([code])
  @@index([mappingCode])
  @@index([uomId])
  @@index([hsnCode])
  @@index([brandId])
  @@index([supplierId])
  @@map("items")
}

model Transaction {
  id                    String          @id @default(uuid()) @db.Uuid
  customerId            String          @map("customer_id") @db.Uuid
  transactionCustomerId String?         @map("transaction_customer_id") @db.Uuid
  totalAmount           Decimal         @map("total_amount") @db.Decimal(10, 2)
  paymentMethod         String          @map("payment_method") @db.VarChar(20)
  receivedAmount        Decimal?        @map("received_amount") @db.Decimal(10, 2)
  changeAmount          Decimal?        @map("change_amount") @db.Decimal(10, 2)
  itemsJson             String          @map("items_json")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  salesCustomerId       String?         @map("sales_customer_id") @db.Uuid
  editedAt              DateTime?       @map("edited_at") @db.Timestamptz(6)
  editedBy              String?         @map("edited_by") @db.Uuid
  originalTransactionId String?         @map("original_transaction_id") @db.Uuid
  transactionType       String          @default("sale") @map("transaction_type") @db.VarChar(20)
  quickSaleItems        QuickSaleItem[]
  returns               ReturnRecord[]
  tableOrder            TableOrder?
  customer              Customer        @relation("CustomerTransactions", fields: [customerId], references: [id], onDelete: Cascade)
  editedByUser          Customer?       @relation("TransactionEditor", fields: [editedBy], references: [id])
  originalTransaction   Transaction?    @relation("TransactionReturns", fields: [originalTransactionId], references: [id])
  returnTransactions    Transaction[]   @relation("TransactionReturns")
  salesCustomer         SalesCustomer?  @relation(fields: [salesCustomerId], references: [id], map: "fk_transactions_sales_customer")
  transactionCustomer   Customer?       @relation("TransactionCustomers", fields: [transactionCustomerId], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@index([salesCustomerId])
  @@index([transactionType])
  @@index([originalTransactionId])
  @@map("transactions")
}

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @unique @map("customer_id") @db.Uuid
  name         String   @db.VarChar(255)
  address      String?
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  pincode      String?  @db.VarChar(20)
  phone        String?  @db.VarChar(20)
  email        String?  @db.VarChar(255)
  gstin        String?  @db.VarChar(50)
  website      String?  @db.VarChar(255)
  logo         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  businessType String   @default("clothing") @map("business_type") @db.VarChar(50)
  nameTamil    String?  @map("name_tamil") @db.VarChar(255)
  addressTamil String?  @map("address_tamil") @db.VarChar(255)
  cityTamil    String?  @map("city_tamil") @db.VarChar(100)
  stateTamil   String?  @map("state_tamil") @db.VarChar(100)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("companies")
}

model Settings {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId          String    @unique @map("customer_id") @db.Uuid
  activityLogEnabled  Boolean?  @default(true) @map("activity_log_enabled")
  itemLogActions      String?   @default("update_delete") @map("item_log_actions") @db.VarChar(20)
  receiptHeaderOption String?   @default("both") @map("receipt_header_option") @db.VarChar(20)
  receiptAutoPrint    Boolean?  @default(true) @map("receipt_auto_print")
  receiptLanguage     String?   @default("en") @map("receipt_language") @db.VarChar(10)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSyncAt          DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastSyncStatus      String?   @map("last_sync_status") @db.VarChar(50)
  supabaseUrl         String?   @map("supabase_url")
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customerId])
  @@map("settings")
}

model ActivityLog {
  id                String   @id @default(uuid()) @db.Uuid
  entityType        String   @map("entity_type") @db.VarChar(50)
  entityId          String   @map("entity_id") @db.Uuid
  action            String   @db.VarChar(20)
  changedBy         String   @map("changed_by") @db.Uuid
  changes           Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  changedByCustomer Customer @relation(fields: [changedBy], references: [id], onDelete: Cascade)

  @@index([entityType])
  @@index([entityId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("activity_logs")
}

model SalesCustomer {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  mobile       String        @db.VarChar(20)
  email        String?       @db.VarChar(255)
  place        String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  carts        Cart[]
  transactions Transaction[]

  @@index([mobile])
  @@map("sales_customers")
}

model QuickSaleItem {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(255)
  quantity         Int
  price            Decimal      @db.Decimal(10, 2)
  totalAmount      Decimal      @map("total_amount") @db.Decimal(10, 2)
  soldAt           DateTime     @default(now()) @map("sold_at") @db.Timestamptz(6)
  addedToInventory Boolean      @default(false) @map("added_to_inventory")
  inventoryItemId  String?      @map("inventory_item_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cost             Decimal?     @db.Decimal(10, 2)
  transactionId    String?      @map("transaction_id") @db.Uuid
  inventoryItem    Item?        @relation(fields: [inventoryItemId], references: [id])
  transaction      Transaction? @relation(fields: [transactionId], references: [id])

  @@index([addedToInventory])
  @@index([inventoryItemId])
  @@index([transactionId])
  @@index([soldAt])
  @@map("quick_sale_items")
}

model CashFlowEntry {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  type        String   @db.VarChar(20)
  category    String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  entryDate   DateTime @map("entry_date") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([entryDate])
  @@index([type])
  @@index([category])
  @@map("cash_flow_entries")
}

model Permission {
  id            String   @id @default(uuid()) @db.Uuid
  customerType  String   @map("customer_type") @db.VarChar(50)
  page          String   @db.VarChar(100)
  canView       Boolean  @default(false) @map("can_view")
  canEdit       Boolean  @default(false) @map("can_edit")
  canDelete     Boolean  @default(false) @map("can_delete")
  canViewProfit Boolean  @default(false) @map("can_view_profit")
  isHidden      Boolean  @default(false) @map("is_hidden")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([customerType, page])
  @@index([customerType])
  @@index([page])
  @@map("permissions")
}

model Cart {
  id              String         @id @default(uuid()) @db.Uuid
  customerId      String         @unique @map("customer_id") @db.Uuid
  itemsJson       String         @map("items_json")
  taxRate         Decimal        @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discount        Decimal        @default(0) @map("discount") @db.Decimal(10, 2)
  paymentMethod   String?        @map("payment_method") @db.VarChar(20)
  salesCustomerId String?        @map("sales_customer_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesCustomer   SalesCustomer? @relation(fields: [salesCustomerId], references: [id])

  @@index([customerId])
  @@map("carts")
}

model Table {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  tableNumber String       @map("table_number") @db.VarChar(50)
  capacity    Int          @default(4)
  status      String       @default("available") @map("status") @db.VarChar(20)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders      TableOrder[]
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tableNumber])
  @@index([customerId])
  @@index([status])
  @@map("tables")
}

model TableOrder {
  id            String       @id @default(uuid()) @db.Uuid
  customerId    String       @map("customer_id") @db.Uuid
  tableId       String       @map("table_id") @db.Uuid
  status        String       @default("pending") @map("status") @db.VarChar(20)
  itemsJson     String       @map("items_json")
  taxRate       Decimal      @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discount      Decimal      @default(0) @map("discount") @db.Decimal(10, 2)
  totalAmount   Decimal?     @map("total_amount") @db.Decimal(10, 2)
  paymentMethod String?      @map("payment_method") @db.VarChar(20)
  transactionId String?      @unique @map("transaction_id") @db.Uuid
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  table         Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([customerId])
  @@index([tableId])
  @@index([createdAt])
  @@index([status])
  @@map("table_orders")
}

model ReturnRecord {
  id                    String      @id @default(uuid()) @db.Uuid
  originalTransactionId String      @map("original_transaction_id") @db.Uuid
  customerId            String      @map("customer_id") @db.Uuid
  returnType            String      @map("return_type") @db.VarChar(20)
  reason                String?
  status                String      @default("pending") @db.VarChar(20)
  refundAmount          Decimal?    @map("refund_amount") @db.Decimal(10, 2)
  restockedItems        Json?       @map("restocked_items")
  exchangeItems         Json?       @map("exchange_items")
  notes                 String?
  approvedBy            String?     @map("approved_by") @db.Uuid
  processedBy           String?     @map("processed_by") @db.Uuid
  approvedAt            DateTime?   @map("approved_at") @db.Timestamptz(6)
  processedAt           DateTime?   @map("processed_at") @db.Timestamptz(6)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  approvedByUser        Customer?   @relation("ReturnApprover", fields: [approvedBy], references: [id])
  customer              Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  originalTransaction   Transaction @relation(fields: [originalTransactionId], references: [id])
  processedByUser       Customer?   @relation("ReturnProcessor", fields: [processedBy], references: [id])

  @@index([customerId])
  @@index([originalTransactionId])
  @@index([status])
  @@index([returnType])
  @@index([createdAt])
  @@map("returns")
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  name           String   @db.VarChar(255)
  code           String?  @db.VarChar(50)
  description    String?
  logoUrl        String?  @map("logo_url")
  website        String?  @db.VarChar(255)
  contactEmail   String?  @map("contact_email") @db.VarChar(255)
  contactPhone   String?  @map("contact_phone") @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          Item[]
  supplierBrands SupplierBrand[]

  @@unique([customerId, name])
  @@index([customerId])
  @@index([code])
  @@index([isActive])
  @@map("brands")
}

model Supplier {
  id             String           @id @default(uuid()) @db.Uuid
  customerId     String           @map("customer_id") @db.Uuid
  name           String           @db.VarChar(255)
  code           String?          @db.VarChar(50)
  contactPerson  String?          @map("contact_person") @db.VarChar(255)
  email          String?          @db.VarChar(255)
  phone          String?          @db.VarChar(50)
  mobile         String?          @db.VarChar(50)
  address        String?
  city           String?          @db.VarChar(100)
  state          String?          @db.VarChar(100)
  pincode        String?          @db.VarChar(20)
  gstin          String?          @db.VarChar(50)
  panNumber      String?          @map("pan_number") @db.VarChar(20)
  paymentTerms   String?          @map("payment_terms") @db.VarChar(100)
  creditLimit    Decimal?         @map("credit_limit") @db.Decimal(15, 2)
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          Item[]
  supplierBrands SupplierBrand[]

  @@unique([customerId, name])
  @@unique([customerId, code])
  @@index([customerId])
  @@index([code])
  @@index([isActive])
  @@index([gstin])
  @@map("suppliers")
}

model SupplierBrand {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  supplierId        String   @map("supplier_id") @db.Uuid
  brandId           String   @map("brand_id") @db.Uuid
  supplierBrandCode String?  @map("supplier_brand_code") @db.VarChar(100)
  isPreferred       Boolean  @default(false) @map("is_preferred")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([customerId, supplierId, brandId])
  @@index([customerId])
  @@index([supplierId])
  @@index([brandId])
  @@index([isPreferred])
  @@map("supplier_brands")
}

model UomMaster {
  id               String          @id @default(uuid()) @db.Uuid
  customerId       String          @map("customer_id") @db.Uuid
  name             String          @db.VarChar(50)
  code             String          @db.VarChar(10)
  category         String          @db.VarChar(20)
  baseUomId        String?         @map("base_uom_id") @db.Uuid
  conversionFactor Decimal?        @default(1.0) @map("conversion_factor") @db.Decimal(10, 6)
  isBaseUom        Boolean         @default(false) @map("is_base_uom")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  items            Item[]
  conversionsFrom  UomConversion[] @relation("FromUom")
  conversionsTo    UomConversion[] @relation("ToUom")
  baseUom          UomMaster?      @relation("BaseUomRelation", fields: [baseUomId], references: [id])
  derivedUoms      UomMaster[]     @relation("BaseUomRelation")
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("uom_master")
}

model UomConversion {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  fromUomId        String    @map("from_uom_id") @db.Uuid
  toUomId          String    @map("to_uom_id") @db.Uuid
  conversionFactor Decimal   @map("conversion_factor") @db.Decimal(10, 6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromUom          UomMaster @relation("FromUom", fields: [fromUomId], references: [id], onDelete: Cascade)
  toUom            UomMaster @relation("ToUom", fields: [toUomId], references: [id], onDelete: Cascade)

  @@unique([customerId, fromUomId, toUomId], map: "uom_conversions_customer_from_to_unique")
  @@index([customerId])
  @@map("uom_conversions")
}

model item_code_prefixes {
  id          String   @id @db.Uuid
  prefix      String   @unique @db.VarChar(255)
  description String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([prefix])
}
